{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node -e \"const fs=require('fs');if(!fs.existsSync('public/build/manifest.json')){console.error('public/build missing');process.exit(1)}console.log('using prebuilt Vite assets')\"",
  "framework": null,
  "outputDirectory": "public",
  "regions": ["sin1"],
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0",
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "routes": [
    {
      "src": "/build/(.*)",
      "dest": "/public/build/$1"
    },
    {
      "src": "/favicon.ico",
      "dest": "/public/favicon.ico"
    },
    {
      "src": "/favicon.svg",
      "dest": "/public/favicon.svg"
    },
    {
      "src": "/favicon-32x32.png",
      "dest": "/public/favicon-32x32.png"
    },
    {
      "src": "/favicon-16x16.png",
      "dest": "/public/favicon-16x16.png"
    },
    {
      "src": "/apple-touch-icon.png",
      "dest": "/public/apple-touch-icon.png"
    },
    {
      "src": "/images/(.*)",
      "dest": "/public/images/$1"
    },
    {
      "src": "/robots.txt",
      "dest": "/public/robots.txt"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}
